{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "worker/**/*.ts",
    "worker-configuration.d.ts",
    "cloudflare-env.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
