{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.vue",
    "src/shared/**/*.ts",
    "src/contract/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.shared.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
