{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // `@cloudflare/workers-types` (not the 585KB generated cloudflare-env.d.ts)
    // supplies KVNamespace/Fetcher for the src/server files this project also
    // compiles. The generated file is .gitignore'd and regenerated by
    // `npm run cf-typegen`, so it must not be a build input.
    "types": ["vite/client", "node", "@cloudflare/workers-types"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.shared.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
