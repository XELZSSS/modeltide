{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Client + shared only: src/server is compiled by tsconfig.worker.json (KVNamespace, Fetcher).
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/shared/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.shared.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
