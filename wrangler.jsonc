{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modeltide",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-22",
  "keep_vars": false,
  "workers_dev": true,

  // Source of truth: vars here overwrite Dashboard on every deploy.
  // Secrets don't belong here — add them in Dashboard or CI.
  "vars": {},

  // Built Vite client on the ASSETS binding; unknown routes fall back to index.html.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },

  // Smart Placement removed by default: KV reads are already global and the
  // extra routing adds cost/uncertainty. Re-enable only with p99 evidence.
  //  "placement": {
  //    "mode": "smart",
  //  },

  // Cron every 30min, not more often: free KV caps at 1,000 writes/day and each
  // tick costs sampling + warmup writes. Only soft-expired keys re-put.
  // Each tick warms the live tier fully plus a rotating bulk slice (~1.5h per
  // full rotation), staying under the free 10ms CPU / 50-subrequest caps.
  // TTL jitter is -10%..0 (27-30m effective), so keys may go stale up to ~3m
  // before the next tick refreshes them; stale-while-revalidate covers the gap.
  "triggers": {
    "crons": ["*/30 * * * *"],
  },

  // Same-Worker hosting needs no CORS. Upstream fetches must stay well under
  // the ~30s wall-clock cap (25s max) to fail gracefully.
  "observability": {
    "enabled": true,
  },

  // KV cache (optional): uncomment to enable. Disabled = direct upstream fetch
  // per request, in-memory status history. Docs: https://developers.cloudflare.com/kv/concepts/kv-bindings/
  // Enable: 1) npx wrangler kv namespace create CACHE  2) paste the id below  3) uncomment.
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "PASTE_KV_NAMESPACE_ID_HERE" }
  // ],

  // Local dev port: Vite owns 3000, so `wrangler dev` uses 8787.
  "dev": {
    "port": 8787,
  },
}
