{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modeltide",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": false,
  "workers_dev": true,

  "vars": {},

  "assets": {
    // Unused with the Cloudflare Vite plugin; kept for `wrangler deploy` parity.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Wrangler wires env.ASSETS only when a name is declared here; without it a non-API request 500s.
    // "/api" is listed explicitly because "/api/*" does not match the bare path.
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
  },

  "triggers": {
    // Off-peak minutes (13/43): keeps the 30-min cadence off the global :00/:30 cron stampede.
    "crons": ["13,43 * * * *"],
  },

  "observability": {
    "enabled": true,
  },

  "placement": {
    "mode": "smart",
  },

  // Replace this placeholder with the account-specific ID before deploying.
  "kv_namespaces": [{ "binding": "CACHE", "id": "df8295997e6f42a7803a9d25b7e12f25" }],

  "dev": {
    "port": 8787,
  },
}
