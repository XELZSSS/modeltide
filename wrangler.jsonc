{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modeltide",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": false,
  "workers_dev": true,

  "vars": {},

  "assets": {
    // Not used with the Cloudflare Vite plugin (it points at the client build
    // output automatically); kept for `wrangler deploy` parity.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // The Worker's non-API branch calls env.ASSETS.fetch, and wrangler only wires
    // that binding when a name is declared here — without it the binding is
    // undefined and any non-API request reaching the Worker answers a plain-text
    // 500. "/api" is listed explicitly because "/api/*" does not match the bare
    // path, which would otherwise fall through to the SPA shell (HTML, 200).
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
  },

  "triggers": {
    // Off-peak minutes (13/43): keep the 30-min cadence but avoid the global
    // :00/:30 cron stampede on shared upstreams (HF, RSS, AA, ...).
    "crons": ["13,43 * * * *"],
  },

  "observability": {
    "enabled": true,
  },

  "placement": {
    "mode": "smart",
  },

  "kv_namespaces": [{ "binding": "CACHE", "id": "df8295997e6f42a7803a9d25b7e12f25" }],

  "dev": {
    "port": 8787,
  },
}
