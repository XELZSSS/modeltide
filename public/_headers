# Vite hashed build output + versioned static assets: cache forever.
# NOTE: assets/fonts/icons below are kept in sync with the service
# worker's immutable set (public/sw.js isImmutableAsset).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Service worker: must revalidate so updates activate promptly.
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# Security headers for static responses. /api/* headers are set in code
# (worker fetch handler + route handlers).
# connect-src 'self': a separate VITE_API_BASE origin must be added here.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  # index.html ships a tiny inline theme/lang init script (no nonce/hash plumbing
  # on static hosting), so script-src explicitly allows 'unsafe-inline'. All other
  # app scripts are hashed files under /assets/*.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
