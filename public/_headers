# Next.js immutable build output: cache forever.
# NOTE: fonts/icons below are versioned static assets kept in
# sync with the service worker's immutable set (public/sw.js isImmutableAsset).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Service worker: must revalidate so updates activate promptly.
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# Security headers for static responses. /api/* headers are set in code
# (custom-worker fetch wrapper + route handlers).
# connect-src 'self': a separate NEXT_PUBLIC_API_BASE origin must be added here.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP for HTML is set by next.config.ts headers (Next.js emits inline hydration scripts,
  # so no static script-src allowlist here); keep this file to static caching.
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
