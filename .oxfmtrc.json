{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "sortPackageJson": false,
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "cloudflare-env.d.ts",
    ".wrangler/**",
    "coverage/**",
    "package-lock.json",
    "public/sw.js"
  ]
}
