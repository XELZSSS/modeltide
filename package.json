{
  "name": "modeltide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "gen:cache-version": "node scripts/gen-cache-version.cjs",
    "build": "node scripts/gen-cache-version.cjs && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "oxlint --vue-plugin --deny-warnings",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "audit": "npm audit --registry=https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@tanstack/vue-query": "^5.104.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "~5.0.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.128.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
