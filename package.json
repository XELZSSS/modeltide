{
  "name": "modeltide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/gen-cache-version.cjs",
    "check": "node scripts/gen-cache-version.cjs && npm run type-check && npm run i18n:check && npm run guard:shared && npm run guard:boundaries && npm run lint",
    "build": "node scripts/gen-cache-version.cjs && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run check && vite build && wrangler deploy",
    "upload": "npm run check && vite build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server",
    "test:shared": "vitest run --project shared",
    "ci": "npm run check && npm run format:check && npm run test:coverage",
    "i18n:check": "node scripts/check-i18n.cjs",
    "guard:shared": "node scripts/check-shared-dom.cjs",
    "guard:boundaries": "node scripts/check-boundaries.cjs",
    "gen:cache-version": "node scripts/gen-cache-version.cjs",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','coverage'])fs.rmSync(p,{recursive:true,force:true})\"",
    "audit": "npm audit --registry=https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "~4.1.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "workerd@1.20260908.1": true
  }
}
