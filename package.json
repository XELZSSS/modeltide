{
  "name": "modeltide",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node build/gen-cache-version.cjs && vite",
    "gen:cache-version": "node build/gen-cache-version.cjs",
    "postinstall": "node build/gen-cache-version.cjs",
    "build": "npm run clean && npm run type-check && npm run lint && npm run format:check && npm run test && npm run build:app",
    "build:app": "node build/gen-cache-version.cjs && node build/bundle-functions.mjs && vite build",
    "preview": "vite preview",
    "type-check": "node build/gen-cache-version.cjs && vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.functions.json",
    "lint": "oxlint --vue-plugin --deny-warnings",
    "lint:fix": "oxlint --vue-plugin --fix",
    "format": "oxfmt --write . && node build/gen-cache-version.cjs",
    "format:check": "oxfmt --check .",
    "test": "node build/gen-cache-version.cjs && vitest run",
    "test:watch": "node build/gen-cache-version.cjs && vitest",
    "clean": "node build/clean.mjs",
    "audit": "npm audit --registry=https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@tanstack/vue-query": "^5.104.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "fast-xml-parser": "^5.11.1",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "~5.0.1",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "vue-demi": true,
    "esbuild": true
  }
}
