{
  "name": "aitiweta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "vite build && node scripts/csp-hash.cjs --write",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "hash:csp": "node scripts/csp-hash.cjs",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "audit": "npm audit --registry=https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.5",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
