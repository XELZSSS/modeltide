{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": ["src/client/**/*.ts", "src/client/**/*.vue"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/server", "@/server/*", "**/server/**", "@/functions", "@/functions/*", "**/functions/**", "@/functions-entry", "@/functions-entry/*", "**/functions-entry/**"],
                "message": "Client code must not import server or functions code. Move the shared piece into src/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/**/*.ts", "src/functions-entry/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/client", "@/client/*", "**/client/**"],
                "message": "Server and functions code must not import the client bundle. Move the shared piece into src/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/parsers/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/server/config", "@/server/config/upstream", "@/server/config/timeouts", "@/server/config/cache", "@/server/config/keys"],
                "message": "Parsers must stay pure: pass bytes/urls/timeouts as arguments instead of importing server config. Limits from @/server/config/limits are allowed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/client", "@/client/*", "**/client/**"],
                "message": "src/shared must stay platform-neutral. Move the client piece into src/client."
              },
              {
                "group": ["@/server", "@/server/*", "**/server/**", "@/functions", "@/functions/*", "**/functions/**", "@/functions-entry", "@/functions-entry/*", "**/functions-entry/**"],
                "message": "src/shared must stay platform-neutral. Move the server piece into src/server."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["build/**/*.ts", "scripts/**/*.{ts,mjs,cjs}", "src/functions-entry/**/*.ts"],
      "rules": {
        "no-unused-vars": "error"
      }
    }
  ]
}
